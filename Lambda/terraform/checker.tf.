variable "sites" {
  description = "URLs the checker watches"
  type        = list(string)
  default     = ["https://github.com", "https://www.cloudflare.com"]
}

resource "aws_dynamodb_table" "checks" {
  name         = "status-page-checks"
  billing_mode = "PAY_PER_REQUEST"
  hash_key     = "site"
  range_key    = "ts"

  attribute {
    name = "site"
    type = "S"
  }

  attribute {
    name = "ts"
    type = "N"
  }

  ttl {
    attribute_name = "expires"
    enabled        = true
  }
}

data "aws_iam_policy_document" "lambda_assume" {
  statement {
    actions = ["sts:AssumeRole"]

    principals {
      type        = "Service"
      identifiers = ["lambda.amazonaws.com"]
    }
  }
}

resource "aws_iam_role" "checker" {
  name               = "status-page-checker"
  assume_role_policy = data.aws_iam_policy_document.lambda_assume.json
}

resource "aws_iam_role_policy_attachment" "checker_logs" {
  role       = aws_iam_role.checker.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
}

data "aws_iam_policy_document" "checker_db" {
  statement {
    actions   = ["dynamodb:PutItem", "dynamodb:Query"]
    resources = [aws_dynamodb_table.checks.arn]
  }
}

resource "aws_iam_role_policy" "checker_db" {
  name   = "checker-dynamodb"
  role   = aws_iam_role.checker.id
  policy = data.aws_iam_policy_document.checker_db.json
}

data "archive_file" "checker" {
  type        = "zip"
  source_file = "${path.module}/../lambda/checker.py"
  output_path = "${path.module}/checker.zip"
}

resource "aws_lambda_function" "checker" {
  function_name    = "status-page-checker"
  role             = aws_iam_role.checker.arn
  runtime          = "python3.12"
  handler          = "checker.handler"
  filename         = data.archive_file.checker.output_path
  source_code_hash = data.archive_file.checker.output_base64sha256
  timeout          = 30

  environment {
    variables = {
      TABLE_NAME = aws_dynamodb_table.checks.name
      SITES      = jsonencode(var.sites)
    }
  }
}

resource "aws_cloudwatch_event_rule" "every_five" {
  name                = "status-page-every-5-min"
  schedule_expression = "rate(5 minutes)"
}

resource "aws_cloudwatch_event_target" "checker" {
  rule = aws_cloudwatch_event_rule.every_five.name
  arn  = aws_lambda_function.checker.arn
}

resource "aws_lambda_permission" "events" {
  statement_id  = "AllowEventBridge"
  action        = "lambda:InvokeFunction"
  function_name = aws_lambda_function.checker.function_name
  principal     = "events.amazonaws.com"
  source_arn    = aws_cloudwatch_event_rule.every_five.arn
}